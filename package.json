{
	"name": "pi-setup-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"build": "pnpm -r --if-present --sort build",
		"typecheck": "pnpm build && pnpm -r typecheck",
		"syntaxcheck": "pnpm build && pnpm -r syntaxcheck",
		"debug:dev-loop": "pnpm build && pnpm --filter @what3vercode/dev-loop debug:pi",
		"debug:dev-loop:print": "pnpm build && pnpm --filter @what3vercode/dev-loop debug:print",
		"check": "pnpm format:check && pnpm lint && pnpm build && pnpm -r typecheck && pnpm -r syntaxcheck"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.3.0",
		"eslint": "^10.9.1",
		"prettier": "^3.9.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.68.0"
	}
}
